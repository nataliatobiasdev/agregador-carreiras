{
  "name": "career-application-manager",
  "productName": "Career Application Manager",
  "version": "1.0.0",
  "description": "Gerenciador local e offline de candidaturas a vagas",
  "main": "./out/main/index.js",
  "author": "Natalia Tobias",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:coverage": "node scripts/run-vitest.mjs run --coverage",
    "test:e2e": "electron-vite build && playwright test",
    "db:generate": "drizzle-kit generate",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@tanstack/react-query": "5.90.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "3.2.4",
    "autoprefixer": "10.4.21",
    "cmdk": "1.1.1",
    "drizzle-kit": "0.31.5",
    "electron": "38.8.6",
    "electron-builder": "26.0.12",
    "electron-vite": "4.0.1",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "lucide-react": "0.544.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.1.0",
    "react-router-dom": "6.30.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vite": "7.3.8",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.44.7",
    "electron-log": "5.4.4",
    "uuid": "11.1.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "3.25.76"
  }
}
